{
  "name": "desktop-widgets",
  "productName": "Desktop Widgets",
  "version": "0.1.0",
  "private": true,
  "description": "Always-on-desktop home screen widgets",
  "author": {
    "name": "Nusrat",
    "email": "nusrat@localhost"
  },
  "homepage": "https://localhost/desktop-widgets",
  "desktopName": "desktop-widgets.desktop",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run icons && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "postinstall": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
