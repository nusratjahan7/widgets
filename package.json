{
  "name": "desktop-widgets",
  "productName": "Widgets",
  "version": "1.4.3",
  "private": true,
  "description": "Frameless X11 desktop widgets: clock, date, calendar, system stats, weather, reminders, and a Win+V clipboard panel.",
  "author": {
    "name": "Nusrat",
    "email": "nusrat@localhost"
  },
  "homepage": "https://github.com/nusratjahan7/widgets",
  "repository": {
    "type": "git",
    "url": "https://github.com/nusratjahan7/widgets.git"
  },
  "bugs": {
    "url": "https://github.com/nusratjahan7/widgets/issues"
  },
  "desktopName": "desktop-widgets.desktop",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run icons && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.json --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "postinstall": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "electron-store": "^12.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "unicode-emoji-json": "^0.9.0",
    "vite": "^8.3.6"
  },
  "build": {
    "appId": "com.nusrat.widgets",
    "productName": "Widgets",
    "copyright": "Copyright © 2026 Nusrat",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/tray.png",
        "to": "tray.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Nusrat <nusrat@localhost>",
      "synopsis": "Home screen widgets for your desktop",
      "desktop": {
        "entry": {
          "Name": "Widgets",
          "Comment": "Home screen widgets for the desktop",
          "Icon": "desktop-widgets",
          "StartupWMClass": "desktop-widgets",
          "X-GNOME-Autostart-enabled": "false"
        }
      }
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libayatana-appindicator3-1",
        "wmctrl",
        "x11-utils",
        "xdotool"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
